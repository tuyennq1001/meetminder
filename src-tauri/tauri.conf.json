{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Meet Minder",
  "version": "1.0.1",
  "identifier": "com.meetminder.desktop",
  "build": {
    "frontendDist": "../src"
  },
  "app": {
    "withGlobalTauri": true,
    "macOSPrivateApi": true,
    "windows": [
      {
        "label": "main",
        "title": "Meet Minder",
        "width": 1200,
        "height": 750,
        "minWidth": 820,
        "minHeight": 240,
        "maximized": true,
        "center": true,
        "transparent": true,
        "decorations": true,
        "titleBarStyle": "Overlay",
        "trafficLightPosition": {
          "x": 8,
          "y": 24
        },
        "hiddenTitle": true,
        "alwaysOnTop": false,
        "resizable": true,
        "skipTaskbar": false
      }
    ],
    "security": {
      "assetProtocol": {
        "enable": true,
        "scope": [
          "$APPDATA/**",
          "$HOME/**",
          "$AUDIO/**",
          "$DOCUMENT/**",
          "$DOWNLOAD/**",
          "$DESKTOP/**"
        ]
      },
      "csp": "default-src 'self'; script-src 'self' 'unsafe-inline'; style-src 'self' 'unsafe-inline' https://fonts.googleapis.com; font-src 'self' https://fonts.gstatic.com; connect-src 'self' ipc://localhost wss: https:; img-src 'self' data:; media-src 'self' data: asset: http://asset.localhost"
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "resources": {
      "../scripts/*": "scripts/"
    },
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "macOS": {
      "entitlements": "Entitlements.plist",
      "frameworks": [],
      "minimumSystemVersion": "13.0",
      "signingIdentity": "-",
      "infoPlist": "Info.plist"
    },
    "createUpdaterArtifacts": false
  },
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IDkxRDczNzFFMTYzOTc5OUQKUldTZGVUa1dIamZYa2NkMllDVnhwM3hqamtZZUJvMGZteFFvSm9ucG55dUdSblZHYWxwSVhabTIK",
      "endpoints": [
        "https://github.com/tuyennq1001/meetminder/releases/latest/download/latest.json"
      ]
    }
  }
}
